# Bu dosyayı .env adıyla kopyalayıp kendi bilgilerinizi girin.

# Trendyol satıcı paneli > Hesap Bilgilerim > Entegrasyon Bilgileri
TRENDYOL_SATICI_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

# Mağaza profil sayfasının adres kısmı (yorumlar için): trendyol.com/magaza/profil/<bu>-m-<satıcı id>
TRENDYOL_MAGAZA_ADI=

# Müşteri ID'lerini anonimleştirirken kullanılan tuz. Değiştirirseniz anonim ID'ler de değişir.
MUSTERI_ID_TUZ=
