# Gizli bilgiler
.env

# Gerçek veri (kişisel veri ve ticari bilgi içerir)
veri/ham/
veri/gercek/

# Üretilen sonuçlar (rapor, tahmin, tavsiye): yeniden üretilebilir; gerçek veriye ait olanlar gizlidir
ciktilar/

# Yeniden üretilebilir tablolar (python guncelle.py --sahte)
veri/sahte/analiz/
veri/*/analiz_kesim_*/

# Sağlamlık kontrolü için başka tohumlarla üretilen sahte veriler (hazirlama/sahte_veri_uret.py --tohum N)
veri/sahte_t*/
veri/sahte_v1*/

# Çalışma çıktıları ve ortam
.venv/
venv/
loglar/
__pycache__/
*.pyc
.ipynb_checkpoints/
